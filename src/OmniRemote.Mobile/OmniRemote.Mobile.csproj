<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- By default target net10.0 for universal compilation, with net10.0-android when building for Android -->
    <TargetFrameworks Condition="'$(BuildingForAndroid)' == 'true'">net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="'$(BuildingForAndroid)' != 'true'">net10.0</TargetFrameworks>
    <OutputType Condition="'$(BuildingForAndroid)' == 'true'">Exe</OutputType>
    <OutputType Condition="'$(BuildingForAndroid)' != 'true'">Library</OutputType>
    <RootNamespace>OmniRemote.Mobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>
    <ApplicationTitle>OmniRemote</ApplicationTitle>
    <ApplicationId>com.omniremote.app</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OmniRemote.Core\OmniRemote.Core.csproj" />
    <ProjectReference Include="..\OmniRemote.Infrastructure\OmniRemote.Infrastructure.csproj" />
    <ProjectReference Include="..\OmniRemote.Integrations.Bluetooth\OmniRemote.Integrations.Bluetooth.csproj" />
    <ProjectReference Include="..\OmniRemote.Integrations.Network\OmniRemote.Integrations.Network.csproj" />
    <ProjectReference Include="..\OmniRemote.Integrations.Infrared\OmniRemote.Integrations.Infrared.csproj" />
    <ProjectReference Include="..\OmniRemote.Integrations.SmartHomeHub\OmniRemote.Integrations.SmartHomeHub.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OmniRemote.UnitTests" />
  </ItemGroup>
</Project>

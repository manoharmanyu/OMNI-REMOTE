# OmniRemote backend configuration TEMPLATE — placeholders only.
# Copy to `.env` (git-ignored) or set as real environment variables / secret-manager entries.
# The mobile app needs NONE of these for simulation mode.

# Environment: Development | Production
ASPNETCORE_ENVIRONMENT=Production

# REQUIRED. Random secret, at least 32 bytes (e.g. `openssl rand -base64 48`).
# The backend refuses to start if missing or too short. There is no default.
Jwt__SigningKey=<replace-with-a-random-48-byte-base64-value>
Jwt__Issuer=omniremote-backend
Jwt__Audience=omniremote-mobile

# SQLite connection string for a self-hosted single-node deployment.
# The file must live outside the web root, with OS permissions restricted to the service account.
ConnectionStrings__OmniRemote=Data Source=/var/lib/omniremote/omniremote.db

# Comma-separated browser origins allowed by CORS. Leave empty for native-app-only deployments.
Cors__AllowedOrigins=
